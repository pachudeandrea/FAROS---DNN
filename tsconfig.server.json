{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": ".",
    "outDir": "build/server"
  },
  "include": ["api/**/*.ts", "server.ts", "src/server/**/*.ts", "scripts/migrate.ts"]
}
