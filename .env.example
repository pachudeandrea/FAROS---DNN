# Gemini AI API Key (Required for search grounding and news pipeline)
GEMINI_API_KEY=

# Public application URL (Required for OAuth redirect URI resolution in production)
APP_URL=https://faros-gamma.vercel.app

# Real Persistent Database (Vercel Postgres, Supabase, Neon or PostgreSQL URL)
# Supported variables: DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING
# (Vercel automatically sets POSTGRES_URL when you connect a Vercel Postgres / Neon store)
DATABASE_URL=
POSTGRES_URL=

# Google OAuth 2.0 Credentials (Google Cloud Console > Credentials > OAuth Client ID)
# Redirect URI: https://faros-gamma.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID / Azure App Registration Credentials (Accounts in any organizational directory + personal accounts)
# Redirect URI (Web): https://faros-gamma.vercel.app/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Admin users allowed to view the internal Admin Panel (/admin)
ADMIN_EMAILS=marudeandrea@gmail.com,pachudeandrea@gmail.com

# Cryptographic secret for signing sessions (optional, defaults to secure random)
SESSION_SECRET=