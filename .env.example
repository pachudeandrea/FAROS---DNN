# ==============================================================================
# VARIABLES DE ENTORNO REQUERIDAS — FAROS
# ==============================================================================

# 1. Base de Datos Principal Unificada (Neon / PostgreSQL)
# Requerida para guardar de forma permanente usuarios, contraseñas, sesiones y carteras.
# Únicamente necesitas configurar DATABASE_URL con el connection string de tu base de datos Neon.
# (NO es necesario configurar POSTGRES_URL si ya tienes DATABASE_URL).
DATABASE_URL=postgresql://neondb_owner:tu_password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Clave de API de Google Gemini (Requerida)
# Utilizada para el análisis de mercado con IA, filtrado de noticias financieras y eventos de calendario.
GEMINI_API_KEY=

# 3. URL Pública de la Aplicación (Requerida en Producción)
# Utilizada para la redirección de autenticación y resolución de rutas.
APP_URL=https://faros-gamma.vercel.app

# ==============================================================================
# VARIABLES OPCIONALES / ADMINISTRACIÓN
# ==============================================================================

# 4. Correos de Administradores (Opcional)
# Lista separada por comas de usuarios con acceso al Panel de Control interno (/admin).
ADMIN_EMAILS=marudeandrea@gmail.com,pachudeandrea@gmail.com

# 5. Secreto de Sesiones (Opcional)
# Semilla criptográfica para firmar cookies de sesión (si no se especifica, se genera una aleatoria segura).
SESSION_SECRET=

# 6. Proveedor de Identidad Google OAuth (Opcional — solo si se activa botón Google)
# Consola de Google Cloud > APIs & Services > Credentials > OAuth Client ID
# URI de redirección autorizada: https://faros-gamma.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 7. Proveedor de Identidad Microsoft OAuth (Opcional — solo si se activa botón Microsoft)
# Portal de Azure > Microsoft Entra ID > App registrations
# URI de redirección Web: https://faros-gamma.vercel.app/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=