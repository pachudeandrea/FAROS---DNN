# Autenticación y cartera: configurar UNA conexión PostgreSQL real.
# En Vercel, reutilizar DATABASE_URL o POSTGRES_URL de la integración Neon.
# No exponer estas variables con un prefijo VITE_. No guardar secretos en Git.
DATABASE_URL=
# POSTGRES_URL=

# Origen público de la aplicación, sin barra final.
APP_URL=https://faros-dnn.vercel.app

# La recuperación usa la clave elegida al registrarse o en Cuenta y Privacidad.
# No requiere un proveedor de correo ni variables adicionales.

# Gemini: análisis de noticias, independiente del registro y almacenamiento.
# Conservar la configuración existente si el proveedor ya inyecta la clave.
GEMINI_API_KEY=

# Opcionales: correos de administradores autorizados, separados por comas.
ADMIN_EMAILS=

# OAuth opcional: ambos valores y la URI autorizada de cada proveedor.
# Google: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: APP_URL/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Solo para PostgreSQL con CA privada; Neon usa CA públicas del sistema.
# PGSSLROOTCERT=/ruta/al/certificado-ca.pem

# Pruebas: base LOCAL descartable. Nunca usar Neon de producción.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/faros_test
